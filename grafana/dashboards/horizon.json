{
  "uid": "dyingstar-horizon",
  "title": "DyingStar — Horizon",
  "tags": [
    "dyingstar",
    "horizon"
  ],
  "description": "Métriques métier de Horizon, exposées par service-monitoring (horizon_*) et collectées par Prometheus (job kubernetes-pods, annotation prometheus.io/scrape).",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
