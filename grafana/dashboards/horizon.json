        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prom}"
        },
        "query": {
          "query": "label_values(horizon_players_connected, namespace)",
          "refId": "ns"
